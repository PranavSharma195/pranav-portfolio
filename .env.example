# Copy this file to ".env" and fill in your own values.
# Never commit your real ".env" file to version control.

# --- Core ---
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Email (contact form) ---
# For Gmail: EMAIL_HOST_USER is your Gmail address, and EMAIL_HOST_PASSWORD
# is a 16-character "App Password" (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the Google account.)
#
# While testing locally without SMTP set up, leave EMAIL_BACKEND as the
# console backend below — messages will just print to your terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com

# The inbox that receives messages submitted through the site's contact form.
CONTACT_RECEIVER_EMAIL=pranavsharma5834@gmail.com
